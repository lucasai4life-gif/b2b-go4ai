# A landing page whose markup and stylesheet deploy together must never be
# half-stale: revalidate everything under /ai-builder. Matches the depth-1
# wildcard form Pages honours on this project (/admin/*).
/ai-builder/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/consultation-modal.js
  Cache-Control: public, max-age=0, must-revalidate

/admin/*
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive

/foundingtalent-survey
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
